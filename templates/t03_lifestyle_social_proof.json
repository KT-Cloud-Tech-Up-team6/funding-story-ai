{
  "schema_version": "funding-story-template-v1",
  "id": "t03_lifestyle_social_proof",
  "template_name": "로봇청소기 라이프스타일·사회적 증거형",
  "category": "테크·가전",
  "language": "ko",
  "generation_source": "manual-analysis",
  "target": "청소 성능뿐 아니라 절약되는 시간, 사용 편의, 브랜드·사용자 경험을 함께 확인하는 사용자",
  "default_word_count": 1800,
  "narration_mode": "lifestyle_first",
  "style": {
    "tone_keywords": ["생활밀착", "편안함", "신뢰감"],
    "sentence_style": "사용 장면과 편익을 먼저 보여주고 뒤에서 기능과 근거를 설명",
    "visual_mood": "정돈된 생활 공간과 제품 사용 장면 중심의 밝고 여유로운 구성",
    "color_palette": ["#1F2937", "#10B981", "#F9FAFB"],
    "font_style": "Sans-serif",
    "typography": "생활 편익 문구는 넓은 여백, 기능·근거는 읽기 쉬운 본문 크기로 표현",
    "urgency_style": "실제 입력된 혜택·수량·기간만 별도 배지로 표시",
    "cta_style": "자신의 생활 상황과 기능·서비스 조건을 비교한 뒤 리워드를 선택하도록 안내"
  },
  "content_strategy": {
    "core_message": "구체적인 사용 장면에서 얻는 편익을 먼저 제시하고 사용자·브랜드 증거와 기능 사실로 신뢰를 보완한다.",
    "product_keywords": ["로봇청소기", "시간절약", "사용편의", "브랜드신뢰", "사용후기"],
    "success_metrics": ["편익과 기능의 출처 연결", "사회적 증거의 기준일 표시", "후기와 성능 증빙 구분"],
    "emphasis_phrases": {
      "lifestyle": ["구체적인 사용 상황", "입력된 편익만 설명"],
      "social_proof": ["표본·기준일 표시", "후기를 시험 결과로 표현하지 않음"],
      "trust": ["브랜드 이력 출처 연결", "AS 조건 공개"]
    }
  },
  "layout": [
    {
      "id": "hero",
      "label": "생활 편익",
      "type": "intro",
      "summary": "제품 사용 후 달라지는 구체적인 생활 장면 제시",
      "expected_content": "타깃 사용자, 사용 상황, 제품이 대신하는 작업, 입력된 핵심 편익과 FEATURE ID",
      "visual_hint": "정돈된 공간과 휴식·다른 활동을 하는 사용 장면",
      "content_type": "lifestyle_image_overlay",
      "image_required": true,
      "overlay_content": "{{lifestyle_benefit}}",
      "html_content": "<section class=\"hero\"><h1>{{headline}}</h1><p>{{lifestyle_benefit}}</p></section>",
      "html_structure": "full-width lifestyle hero"
    },
    {
      "id": "use_cases",
      "label": "사용 상황",
      "type": "problem",
      "summary": "타깃별 청소 문제와 사용 시점을 구분",
      "expected_content": "AUDIENCE·PROBLEM ID를 연결한 최대 4개의 사용 상황",
      "visual_hint": "맞벌이·반려동물·1인 가구 등 실제 입력된 타깃만 카드로 표현",
      "content_type": "use_case_cards",
      "image_required": false,
      "overlay_content": null,
      "html_content": "<section class=\"use-cases\"><h2>{{use_case_heading}}</h2><div>{{use_case_cards}}</div></section>",
      "html_structure": "audience-specific use case grid"
    },
    {
      "id": "benefit_map",
      "label": "기능이 만드는 편익",
      "type": "solution",
      "summary": "기능 사실과 사용자 편익을 과장 없이 연결",
      "expected_content": "FEATURE·FACT ID, 사용 조건, 직접 설명 가능한 편익과 제한",
      "visual_hint": "사용 전 상황과 기능 사용 후 상황을 나란히 표현",
      "content_type": "before_after",
      "image_required": true,
      "overlay_content": "{{supported_benefit}}",
      "html_content": "<section class=\"benefits\"><h2>{{benefit_heading}}</h2><div>{{feature_benefit_pairs}}</div></section>",
      "html_structure": "before-and-after feature mapping"
    },
    {
      "id": "social_proof",
      "label": "사용자·펀딩 이력",
      "type": "social_proof",
      "summary": "이전 만족도·후기·누적 수치를 기준일과 함께 제시",
      "expected_content": "리뷰 점수·표본 수·누적 펀딩·참여자 등 입력된 사실, 기준일, 출처와 한계",
      "visual_hint": "수치 카드와 짧은 후기 요약. 원문 장문 인용 금지",
      "content_type": "proof_metrics",
      "image_required": false,
      "overlay_content": null,
      "html_content": "<section class=\"social-proof\"><h2>{{proof_heading}}</h2><dl>{{proof_metrics}}</dl></section>",
      "html_structure": "dated proof metric cards"
    },
    {
      "id": "offer",
      "label": "혜택·AS",
      "type": "offer",
      "summary": "가격 혜택과 사후 서비스를 서로 다른 근거로 설명",
      "expected_content": "리워드 가격·구성·기준 가격, AS 기간·범위·제외 조건과 출처",
      "visual_hint": "가격 카드와 AS 카드 분리. 기준 가격이 없으면 할인 표현 제외",
      "content_type": "offer_service_cards",
      "image_required": false,
      "overlay_content": null,
      "html_content": "<section class=\"offer\"><h2>{{offer_heading}}</h2><div>{{price_card}}{{service_card}}</div></section>",
      "html_structure": "separate price and service cards"
    },
    {
      "id": "feature_experience",
      "label": "기능별 사용 경험",
      "type": "feature",
      "summary": "주요 기능을 실제 사용 단계와 연결",
      "expected_content": "최대 5개 FEATURE ID, 작동 조건, 사용자 조작, 기대 가능한 결과와 증빙",
      "visual_hint": "기능 데모 또는 앱 화면과 사용 상황 이미지",
      "content_type": "feature_story_cards",
      "image_required": false,
      "overlay_content": null,
      "html_content": "<section class=\"features\"><h2>{{features_heading}}</h2><div>{{feature_story_cards}}</div></section>",
      "html_structure": "feature cards with use context"
    },
    {
      "id": "brand_trust",
      "label": "브랜드 신뢰",
      "type": "trust",
      "summary": "브랜드 이력과 공식 증빙을 기준일·범위와 함께 설명",
      "expected_content": "브랜드 연혁, 누적 프로젝트, 인증·수상·보험·서비스 정보와 출처",
      "visual_hint": "연혁 타임라인과 증빙 목록",
      "content_type": "brand_timeline",
      "image_required": false,
      "overlay_content": null,
      "html_content": "<section class=\"brand\"><h2>{{brand_heading}}</h2><ol>{{brand_timeline}}</ol><ul>{{brand_evidence}}</ul></section>",
      "html_structure": "brand timeline followed by evidence"
    },
    {
      "id": "reward",
      "label": "리워드 구성",
      "type": "reward",
      "summary": "구성품·옵션·가격·수량을 제품 경험과 분리해 정확히 표시",
      "expected_content": "REWARD ID별 구성품, 가격, 수량, 옵션과 배송 차수",
      "visual_hint": "실제 구성품 이미지와 표",
      "content_type": "reward_cards",
      "image_required": false,
      "overlay_content": null,
      "html_content": "<section class=\"rewards\"><h2>{{reward_heading}}</h2><div>{{reward_cards}}</div></section>",
      "html_structure": "repeatable reward cards"
    },
    {
      "id": "faq",
      "label": "FAQ",
      "type": "faq",
      "summary": "호환·관리·소모품·앱·AS 질문을 사실 기반으로 정리",
      "expected_content": "답변 가능한 질문과 연결 source_fields. 근거가 없으면 미확인 질문으로 전환",
      "visual_hint": "접고 펼치는 질문 목록",
      "content_type": "accordion",
      "image_required": false,
      "overlay_content": null,
      "html_content": "<section class=\"faq\"><h2>FAQ</h2><div>{{faq_items}}</div></section>",
      "html_structure": "accordion question list"
    },
    {
      "id": "project_detail",
      "label": "일정·정책",
      "type": "policy",
      "summary": "배송·환불·AS와 미확인 정보를 마지막에 명시",
      "expected_content": "SCHEDULE_POLICY 값, 문의 경로, UNKNOWN 항목과 생성 제외 내용",
      "visual_hint": "일정·정책 표와 검토 필요 박스",
      "content_type": "detail_table",
      "image_required": false,
      "overlay_content": null,
      "html_content": "<section class=\"project-detail\"><h2>{{detail_heading}}</h2><dl>{{policy_details}}</dl><aside>{{unknown_items}}</aside></section>",
      "html_structure": "policy table with review-required box"
    }
  ]
}
