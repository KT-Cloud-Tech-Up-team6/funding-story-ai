{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/template-catalog.schema.json",
  "title": "Story Template Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "templates"],
  "properties": {
    "schema_version": { "const": "template-catalog-v1" },
    "updated_at": { "type": "string", "format": "date" },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template_id",
          "template_version",
          "source_project_ids",
          "source_urls",
          "extracted_pattern_notes",
          "review_status",
          "reviewed_by",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "template_id": { "type": "string", "pattern": "^t[0-9]{2}_[a-z0-9_]+$" },
          "template_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "source_project_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]+$" }
          },
          "source_urls": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uri" }
          },
          "source_observation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" }
          },
          "extracted_pattern_notes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "review_status": { "enum": ["draft", "codex-reviewed", "user-approved", "rejected"] },
          "reviewed_by": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date" },
          "updated_at": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
