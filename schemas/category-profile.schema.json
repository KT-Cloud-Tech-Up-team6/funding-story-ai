{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/category-profile.schema.json",
  "title": "Story category profile",
  "description": "제품군 독립 코어 슬롯에 카테고리별 추출 힌트·질문 예시·템플릿 soft boost를 주입한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "language",
    "category",
    "product_types",
    "match_terms",
    "semantic_slot_guidance",
    "template_soft_boosts"
  ],
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "slot_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraction_hints", "question_examples"],
      "properties": {
        "extraction_hints": {"$ref": "#/$defs/string_list"},
        "question_examples": {"$ref": "#/$defs/string_list"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "category-profile-v1"},
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "language": {"const": "ko"},
    "category": {"$ref": "#/$defs/non_empty_string"},
    "product_types": {"$ref": "#/$defs/string_list"},
    "match_terms": {"$ref": "#/$defs/string_list"},
    "semantic_slot_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_identity",
        "key_strengths",
        "target_supporters",
        "problem_context",
        "trust_elements",
        "maker_team_intro"
      ],
      "properties": {
        "product_identity": {"$ref": "#/$defs/slot_guidance"},
        "key_strengths": {"$ref": "#/$defs/slot_guidance"},
        "target_supporters": {"$ref": "#/$defs/slot_guidance"},
        "problem_context": {"$ref": "#/$defs/slot_guidance"},
        "trust_elements": {"$ref": "#/$defs/slot_guidance"},
        "maker_team_intro": {"$ref": "#/$defs/slot_guidance"}
      }
    },
    "template_soft_boosts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^t[0-9]{2}_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": -20,
        "maximum": 20
      }
    }
  }
}
