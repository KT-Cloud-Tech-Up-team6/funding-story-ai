{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/story-image-manifest.schema.json",
  "title": "Story Section Image Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "story_sha256",
    "reference_sha256",
    "model",
    "size",
    "quality",
    "requested",
    "succeeded",
    "failed",
    "estimated_cost_usd",
    "assets"
  ],
  "properties": {
    "schema_version": { "const": "story-image-manifest-v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "story_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reference_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_mode": {
      "enum": ["reference-edit", "text-generate", "text-seeded-edit"]
    },
    "generated_seed_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": { "type": "string", "minLength": 1 },
    "size": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
    "quality": { "enum": ["low", "medium", "high"] },
    "requested": { "type": "integer", "minimum": 0 },
    "succeeded": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "estimated_cost_usd": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "status",
          "prompt_sha256",
          "path",
          "sha256",
          "duration_ms",
          "estimated_cost_usd",
          "usage",
          "error_type",
          "qa_status",
          "qa_notes"
        ],
        "properties": {
          "section_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["success", "error"] },
          "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "path": { "type": ["string", "null"] },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "estimated_cost_usd": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text_input_tokens", "image_input_tokens", "image_output_tokens"],
            "properties": {
              "text_input_tokens": { "type": "integer", "minimum": 0 },
              "image_input_tokens": { "type": "integer", "minimum": 0 },
              "image_output_tokens": { "type": "integer", "minimum": 0 }
            }
          },
          "error_type": { "type": ["string", "null"] },
          "qa_status": { "enum": ["pending", "pass", "conditional", "fail"] },
          "qa_notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
