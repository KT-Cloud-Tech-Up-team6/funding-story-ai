{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/story-generation-content.schema.json",
  "title": "Model-generated Story Content",
  "description": "모델이 생성하는 콘텐츠만 정의하며 실행 상태와 파일 정보는 애플리케이션이 별도로 결합한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title_candidates", "sections"],
  "$defs": {
    "source_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(product\\.(name|summary|category|product_type)|schedule_policy|unknown\\.[a-z0-9_]+|(?:fact|aud|problem|feature|claim|evidence|asset|reward)_[a-z0-9_]+)$"
      }
    }
  },
  "properties": {
    "title_candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template_section_id",
          "type",
          "heading",
          "body",
          "source_fields",
          "image_intent"
        ],
        "properties": {
          "template_section_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "heading": { "type": "string", "minLength": 1, "maxLength": 120 },
          "body": { "type": "string", "minLength": 1 },
          "source_fields": { "$ref": "#/$defs/source_fields" },
          "image_intent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "purpose", "visual_hint", "source_fields"],
            "properties": {
              "required": { "type": "boolean" },
              "purpose": { "type": "string" },
              "visual_hint": { "type": "string" },
              "source_fields": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(product\\.(name|summary|category|product_type)|unknown\\.[a-z0-9_]+|(?:fact|aud|problem|feature|claim|evidence|asset|reward)_[a-z0-9_]+)$"
                }
              }
            }
          }
        }
      }
    }
  }
}
