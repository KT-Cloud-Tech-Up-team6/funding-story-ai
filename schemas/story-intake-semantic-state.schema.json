{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funding-story-ai.local/schemas/story-intake-semantic-state.schema.json",
  "title": "Product-agnostic story intake semantic state",
  "description": "질문 분기에 필요한 제품군 독립 의미 슬롯과 대화 턴 상태를 분리한 내부 상태다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_id",
    "profile_id",
    "image_attached",
    "slots",
    "fact_conflict",
    "turn_state"
  ],
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "values", "source_turn"],
      "properties": {
        "status": {
          "enum": ["provided", "explicitly-absent", "unknown"]
        },
        "values": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "source_turn": {
          "enum": ["initial", "followup", "none"]
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": "story-intake-semantic-state-v1"},
    "input_id": {"$ref": "#/$defs/non_empty_string"},
    "profile_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "image_attached": {"type": "boolean"},
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_identity",
        "key_strengths",
        "target_supporters",
        "problem_context",
        "trust_elements",
        "maker_team_intro"
      ],
      "properties": {
        "product_identity": {"$ref": "#/$defs/slot"},
        "key_strengths": {"$ref": "#/$defs/slot"},
        "target_supporters": {"$ref": "#/$defs/slot"},
        "problem_context": {"$ref": "#/$defs/slot"},
        "trust_elements": {"$ref": "#/$defs/slot"},
        "maker_team_intro": {"$ref": "#/$defs/slot"}
      }
    },
    "fact_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authoritative_values", "superseded_values"],
      "properties": {
        "status": {
          "enum": ["none", "superseded-resolved", "unresolved"]
        },
        "authoritative_values": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "superseded_values": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_string"}
        }
      }
    },
    "turn_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_answered",
        "combined_answered",
        "secondary_answered",
        "skip_requested",
        "confirmed"
      ],
      "properties": {
        "primary_answered": {"type": "boolean"},
        "combined_answered": {"type": "boolean"},
        "secondary_answered": {"type": "boolean"},
        "skip_requested": {"type": "boolean"},
        "confirmed": {"type": "boolean"}
      }
    }
  }
}
