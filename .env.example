GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

GEMINI_PRIMARY_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_PRIMARY_ACCESS_ATTEMPTS=5
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_THINKING_LEVEL=LOW

GCP_SPEND_LIMIT_KRW=10000
USD_TO_KRW=1500
USAGE_LEDGER_PATH=reports/usage.jsonl

# Gemini 3.7 Flash는 공개 가격표에서 단가를 확인할 수 없어 기본적으로
# Gemini 3.6 Flash Standard 단가를 보수적 대리값으로 사용합니다.
# 확인 가능한 계약 단가가 있을 때만 아래 값을 설정하세요.
# GEMINI_37_INPUT_USD_PER_MILLION=
# GEMINI_37_OUTPUT_USD_PER_MILLION=

OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
OPENAI_IMAGE_OUTPUT_COMPRESSION=85
OPENAI_SPEND_LIMIT_USD=5.00
OPENAI_IMAGE_RESERVE_USD_PER_CALL=0.50
OPENAI_IMAGE_USAGE_LEDGER_PATH=reports/openai-image-usage.jsonl
